# 开发环境配置模板（复制为 .env 填入真实值；.env 已被 gitignore）
# CLI 全局安装(npm i -g)后改用 ~/.flagent/config.json（/platform /model 命令写入），不依赖 .env
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
# 平台：qianwen（千问，无需 workspaceId）或 bailian（百炼，需 workspaceId）
PLATFORM=bailian
WORKSPACE_ID=your-workspace-id
MODEL_NAME=qwen3.8-max
MAX_CONTEXT_TOKENS=8000
SUMMARY_THRESHOLD_TOKENS=4000
WINDOW_MESSAGES=10
