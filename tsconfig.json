{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/context/**/*", "src/tools/**/*", "src/agents/**/*", "src/cli/**/*", "src/llm/**/*", "src/permissions/**/*", "src/session/**/*", "src/index.ts"],
  "exclude": ["node_modules", "dist", "src/vscode/**/*"]
}